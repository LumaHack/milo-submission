# Copy this file to .env.local and fill it in. .env.local is ignored by git.
# Never paste a real key into this file.

# Anthropic: Claude keeps Nolan's notes, compares the accounts and writes the scene instructions
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Optional. Claude runs in fast mode by default (quicker, about twice the price). Set to 0 for standard speed
NOLAN_FAST=

# ElevenLabs: Nolan's voice and ears. His agent is created by itself on the first interview
ELEVENLABS_API_KEY=
# Optional. Pin an existing agent instead of finding it by name
ELEVENLABS_NOLAN_AGENT_ID=
# Optional. A voice id for Nolan, and the agent's model (default claude-haiku-5-5)
ELEVENLABS_NOLAN_VOICE_ID=
ELEVENLABS_AGENT_LLM=

# fal: draws the scenes, after the last interview. Format is key_id:key_secret
FAL_KEY=

# Optional. The https address witnesses reach this machine on, for interview links. Without it the links
# use this machine's network address over http, which a phone will not allow a microphone on.
NOLAN_PUBLIC_URL=
# Optional. Set to 1 to serve the investigator's screens to any address, not only localhost
NOLAN_OPEN=
