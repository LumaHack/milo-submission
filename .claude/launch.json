{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "milo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "nolan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
