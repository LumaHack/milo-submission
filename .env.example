# Copy this file to .env.local and fill it in. .env.local is ignored by git.
# Get the values from the team chat. Never paste a real key into this file.

# fal: draws the whiteboard and Milo. Format is key_id:key_secret
FAL_KEY=

# Anthropic: Claude scores each turn and writes the drawing instruction
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Optional. Claude runs in fast mode by default (quicker, about twice the price). Set to 0 for standard speed
MILO_FAST=
# Optional. The final sheet uses fal's careful model (about 18 s, labels spelled right). Set to 0 to use the fast model at Basics
MILO_CAREFUL_FINAL=
# Optional. Set to 0 to hide the "Your notes" upload on the Start screen
NEXT_PUBLIC_MILO_NOTES=

# ElevenLabs: Milo's voice and ears
ELEVENLABS_API_KEY=
# The id of Milo's agent. Create it once with:  curl -X POST http://localhost:3000/api/elevenlabs/setup
# Teammates using the same ElevenLabs key can share the same id.
ELEVENLABS_AGENT_ID=
# Optional, only read when the agent is created: a voice id, and the agent's model (default claude-haiku-5-5)
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_LLM=

# Anam: optional live face for Milo
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_LLM_ID=

# Figma: only needed if you use the Figma API or MCP
FIGMA_ACCESS_TOKEN=

# Adaption: optional grading model, once it is trained
ADAPTION_API_KEY=
ADAPTION_MODEL_ID=
