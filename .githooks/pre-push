#!/bin/sh
# Blocks a direct push to main. Main only changes through a pull request.
# Turn this on once per clone:  git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main blocked. Push your own branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
